# Copy this file to .env.local and fill it in. Never commit real secrets.
#
# The Supabase project URL (Project Settings > API). This is the only value the
# browser needs: the registration Edge Functions are public endpoints, and the
# secret key stays inside Supabase.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# ---------------------------------------------------------------------------
# Admin only. Put these in a separate file named .env.admin (never committed),
# used by `npm run round:export` on your own machine. Never add VITE_ to these
# names and never put the secret key in Vercel or in the browser.
#
# SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# SUPABASE_SECRET_KEY=paste-the-secret-key-here-in-the-file-only
